@startuml 01-building-blocks
' Source of truth for docs/images/01-building-blocks.svg — regenerated by
' .github/workflows/render-diagrams.yml. Edit this file, never the SVG.
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 8
skinparam componentStyle rectangle
skinparam ArrowColor #33475B
skinparam ArrowFontColor #33475B
skinparam DefaultFontName "Segoe UI"
skinparam component {
  BackgroundColor #F4F7FB
  BorderColor #33475B
}
skinparam database {
  BackgroundColor #EFEAE0
  BorderColor #6B5B3E
}
skinparam cloud {
  BackgroundColor #F0F0F0
  BorderColor #808080
}

actor "Visitor /\nAdmin" as user

cloud "GitHub" as github {
  component "GitHub Actions\n(CI: checks, deploy,\ndiagram rendering)" as ci
}

node "VPS (Ubuntu 24.04)" as vps {
  component "nginx\n(TLS, rate-limit zone\n/api/auth/login)" as nginx

  node "systemd: yuriisoft-frontend[-dev]" as systemd {
    component "Next.js App Router\n(frontend/)\n— pages, Route Handlers,\nproxy.ts (Edge)" as nextjs
    component "@portfolio/backend\n(auth/, content/, db/)\n— imported in-process,\nnot a separate HTTP service" as backend
  }

  database "PostgreSQL\n127.0.0.1:5432" as postgres
  component "PlantUML renderer\n(systemd, 127.0.0.1:8082)\nfor post content only —\nunreachable outside the VPS" as plantuml
}

cloud "Upstash Redis\n(shared rate-limit counters)" as redis

user --> nginx : HTTPS
nginx --> nextjs : 127.0.0.1:3000/3001
nextjs -[#33475B,bold]-> backend : in-process\n(same Node process)
backend --> postgres : Prisma + pg driver
nextjs ..> plantuml : /api/diagrams/plantuml/*\n(renders diagram blocks)
nextjs ..> redis : limit checks\n(when configured)

ci .[#808080,dashed].> github : artifacts, deploy\nvia SSH/SCP to the VPS
ci -[#808080,dashed]-> vps : appleboy/scp+ssh-action\n(release deploy,\nnot part of runtime traffic)

note bottom of plantuml
  Private, intended only for local use by the
  Next.js app itself. CI cannot and must not reach
  this server — the images for this README are
  rendered by a separate, self-contained PlantUML
  image inside the CI runner itself
  (see 03-deployment-cicd.puml).
end note

@enduml
