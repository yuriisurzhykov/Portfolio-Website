@startuml 02-components
' Source of truth for docs/images/02-components.svg — regenerated by
' .github/workflows/render-diagrams.yml. Edit this file, never the SVG.
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 8
skinparam componentStyle rectangle
skinparam ArrowColor #33475B
skinparam DefaultFontName "Segoe UI"
skinparam component {
  BackgroundColor #F4F7FB
  BorderColor #33475B
}
skinparam package {
  BackgroundColor #FBFBFB
  BorderColor #9AA5B1
}

package "frontend/  (Next.js, feature-sliced design)" {
  component "app/\nRoute Handlers + layouts\n(thin layer, no business logic)" as app
  component "proxy.ts\n(Edge: rate-limit + locale)" as proxy
  component "views/\npage composition\n(admin-* and public)" as views
  component "widgets/\nnav, footer, AppLayout,\nAdminNav" as widgets
  component "feature/\ntheme-toggle,\nDesignSystemPlayground" as feature
  component "shared/ui/\nblock-editor, diagram,\nform, drawer, ..." as sharedui
  component "shared/lib/\nauth/, admin-api,\nrender-with-fallback" as sharedlib
}

package "@portfolio/backend  (in-process library)" {
  component "auth/\nauth-service, session,\njwt, password, rate-limit" as auth
  component "content/\nposts, work, blocks,\nlifecycle, document" as content
  component "db/\nPrisma client + adapter-pg" as db
  component "errors.ts\nDatabaseUnavailableError\n(distinguished by .name,\nnot instanceof)" as errors
}

database "PostgreSQL" as pg

app --> views
app --> auth : /api/auth/*,\n/api/admin/*
app --> content : /api/admin/posts|work/*
views --> widgets
views --> feature
views --> sharedui
views --> sharedlib
sharedlib --> auth : @portfolio/backend/edge\n(Edge-safe import)
proxy --> auth : rate-limit only,\nno JWT verification
sharedui --> content : block editor ↔\nBlockInput[] schema
auth --> db
content --> db
db --> pg
auth ..> errors
content ..> errors

note bottom of proxy
  Since 2026-07, authorization has moved out of the
  Edge proxy: only IP rate-limiting and locale live
  here now. The real JWT check happens per Route
  Handler/page (defineAdminRoute, requirePage),
  see 04-auth-flow.puml.
end note

@enduml
