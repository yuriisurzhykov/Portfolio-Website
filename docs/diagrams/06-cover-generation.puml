@startuml 06-cover-generation
' Source of truth for docs/images/06-cover-generation.svg — regenerated by
' .github/workflows/render-diagrams.yml. Edit this file, never the SVG.
skinparam backgroundColor white
skinparam shadowing false
skinparam roundCorner 8
skinparam DefaultFontName "Segoe UI"
skinparam ArrowColor #33475B
skinparam ArrowFontColor #33475B
skinparam NoteBackgroundColor #FBEFD5
skinparam NoteBorderColor #A9822C
skinparam activity {
  BackgroundColor #F4F7FB
  BorderColor #33475B
  DiamondBackgroundColor #EFEAE0
  DiamondBorderColor #6B5B3E
}
skinparam partition {
  BackgroundColor #FAFAFA
  BorderColor #808080
  FontColor #33475B
}

start

partition "Trigger (createPost / createWork)" {
  :title + excerpt/summary + slug
  + category (or Work slug) + date;
}

partition "Deterministic inputs" {
  :resolveIdentityHue(kind, key)
  — van der Corput, base-2 assignment
  over ONE shared ordinal pool for
  categories AND Work projects;
  :seed = `${slug}:${styleVersion}:${variant}`
  → cyrb128 → sfc32 PRNG
  (no Math.random anywhere);
}

partition "Composition (cover-composition.ts)" {
  :OKLCH mesh spots
  (hue ± 20–40°, mix-blend-mode: overlay);
  :flow curves
  (count/amplitude from title+excerpt word stats);
  :wave ridges
  (from character codes of title+excerpt);
  :letterform clip
  (title's first word, filled by the mesh);
  :readable title
  (fontkit glyph metrics + embedded Inter);
  :stamp
  (category/"Project" + 4-hex ref(slug) + date);
}

partition "Raster & store" {
  :SVG → WebP via sharp/librsvg
  (1200w + 640w) + inline LQIP;
  :MediaAsset, content-addressed
  by sha256(webp) — identical
  renders dedupe for free;
}

:served from /media/...
via nginx, Cache-Control: immutable;

stop

note right
  Regenerated on publish() only if
  {hue, contentHash, styleVersion} drifted
  from the last save — never on autosave,
  same draft/publish boundary as
  05-content-lifecycle.puml.

  NOT reused as og:image: that stays a
  separate readable text card (next/og) —
  only the accent hue is shared between
  the two.
end note

@enduml
