# Required for a clean `npm install` to succeed at all: @mantine/hooks@9.5.1
# conflicts with @mantine/core@8.3.18's exact peer pin on @mantine/hooks (a
# deliberate, accepted version-skew — see frontend/package.json). `overrides`
# in package.json cannot force a nested install for a peer-only relationship
# (verified live: an override only rewrites the declared peer range, it does
# not create a separate copy) — `npm ci` already tolerates the resulting
# "invalid" peer state fine (it trusts the lockfile rather than re-deriving
# the tree), but a full `npm install` from a clean node_modules does not,
# without this.
legacy-peer-deps=true
