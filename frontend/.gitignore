# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the safe, secret-free template (mirrors backend/.env.test.example, which is tracked
# for the same reason) — see tests/README.md section 3 for what it's for.
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# mutation testing (StrykerJS)
.stryker-tmp
/reports

# Local-only output of scripts/og-contact-sheet.mjs — regenerated on demand
# against a running server, never a committed artifact. The OG cards that
# ARE committed are the Playwright baselines in tests/visual-snapshots/.
/.og-cards/

# Playwright — generated on every run, never commit. tests/visual-snapshots/ is NOT listed here
# on purpose: those PNGs are the committed baseline "references" (see tests/README.md).
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/.generated/
