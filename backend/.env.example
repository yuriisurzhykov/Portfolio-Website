# Copy to backend/.env for local development (never commit the real .env —
# it's covered by the repo-root .gitignore's "*.env" style rule already).
# web/next.config.ts loads this same file explicitly, so there is exactly
# one place DATABASE_URL/JWT secrets live for local dev — see backend/README.md.

# Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://portfolio:portfolio_dev_only@127.0.0.1:5432/portfolio"
PLANTUML_SERVER_URL="http://127.0.0.1:8081"

# Generate a real value with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be at least 32 characters (see jwt.ts's getAccessSecret()) — HS256
# with a short/guessable secret is brute-forceable offline. There is no
# JWT_REFRESH_SECRET: refresh tokens are opaque, CSPRNG-generated strings
# (backend/src/auth/tokens.ts), never JWTs, so there's nothing for a
# second signing secret to protect — a var of that name existed here for a
# while with nothing reading it, which is worse than not having it at all.
JWT_ACCESS_SECRET="replace-me-with-at-least-32-random-characters"

# Optional. Rate limiting (backend/src/auth/rate-limit.ts) uses Upstash
# Redis in production so the counters are shared across every app instance
# behind a load balancer. Without these two set, rate limiting silently
# falls back to an in-memory counter scoped to THIS process only — fine for
# local dev/tests, not for a horizontally-scaled deployment. Get both from
# an Upstash Redis database's REST API tab (https://upstash.com).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""