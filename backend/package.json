{
  "name": "@portfolio/backend",
  "version": "0.0.1",
  "private": true,
  "description": "Server-only code for the portfolio site: Prisma schema/client, auth, business-logic services. Consumed by web/ (Next.js) as an npm workspace package — not a separate deployable process, see web/README.md for the single-process decision.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./edge": "./src/edge.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev && prisma generate",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed-site-content": "tsx scripts/seed-site-content.ts",
    "backfill-post-covers": "tsx scripts/backfill-post-covers.ts",
    "backfill-work-covers": "tsx scripts/backfill-work-covers.ts",
    "seed-e2e-fixtures": "dotenv -e .env.test -- tsx scripts/seed-e2e-fixtures.ts",
    "cleanup-expired-sessions": "tsx scripts/cleanup-expired-sessions.ts",
    "test": "npm run test:migrate && vitest run",
    "test:watch": "vitest",
    "test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/fontkit": "^2.0.9",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@upstash/redis": "^1.38.0",
    "argon2": "^0.45.0",
    "fontkit": "^2.0.4",
    "jose": "^6.2.8",
    "pg": "^8.22.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
