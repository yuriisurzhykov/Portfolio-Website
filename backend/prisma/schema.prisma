// Prisma schema — Phase 2 (auth: User + Session) + Phase 3 (content:
// Document/Block/Post/Work) + Phase 5 (SiteContent).
// See backend/README.md and the migration plan for the full model design.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Draft/publish visibility for `Post`/`Work` — whether a record is shown
/// on the public site AT ALL, independent of `Post.status`/`Work.status`
/// (which describe something else: how an ALREADY-visible record reads,
/// e.g. "upcoming" vs "published", "shipped" vs "in-progress"). A REAL
/// Prisma enum here, unlike `Block.type` (a plain `String` — see its own
/// comment above `Block` for why): the set of lifecycle states is a fixed,
/// closed transition graph owned by `content/lifecycle.ts` (`nextState()`)
/// — it doesn't grow every time a new content shape is added the way block
/// types do, so there's no "new enum value = a migration every time" cost
/// to worry about here. Two fields, not a bigger state object, because
/// that's genuinely all the state a two-state machine needs: which state
/// it's in, and when it last entered PUBLISHED.
enum LifecycleState {
  DRAFT
  PUBLISHED
}

/// A person who can log into /admin. One row today (you) — modeled as a
/// real table from day one (not a hardcoded single-admin check) so adding a
/// second user or a role later is a data change, not a redesign.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
}

/// One row per issued refresh token (= one row per logged-in device).
/// Storing a hash of the refresh token (never the raw token) means a
/// leaked database dump alone can't be used to impersonate a session —
/// same principle as passwordHash. Deleting/revoking a row instantly
/// invalidates that device without touching any other session, which is
/// what makes "sign out this device" (and multi-device / future mobile
/// client support) possible without redesigning anything later.
model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Set ONLY when this row was revoked because `rotateSession` replaced it
  /// with a new one (holds that new session's id) — deliberately NOT set
  /// by `revokeSession` (explicit single-device logout) or
  /// `revokeAllSessionsForUser` ("sign out everywhere"). This is what lets
  /// refresh-token REUSE detection (session.ts's `detectReuseAndRevokeFamily`)
  /// tell "someone replayed a token that was already rotated away — likely
  /// theft" apart from "someone replayed a token from a device that was
  /// deliberately logged out" — both leave `revokedAt` set, but only the
  /// first is evidence of anything, and conflating them would make an
  /// ordinary logout collateral-damage every OTHER active session for that
  /// user (found by a failing pre-existing test:
  /// `revokeSession`'s "revokes only the targeted session" — see
  /// session.test.ts). Plain string, no `@relation`: this is a bookkeeping
  /// marker read back by primary key on an already-fetched row, not a join
  /// target, so a real foreign-key relation would add self-relation
  /// complexity for no actual query need.
  replacedBySessionId String?

  @@index([userId])
}

/// A journal post's body OR a work item's case-study narrative — the same
/// container either way, see backend/src/content/README.md for why a case
/// study is architecturally just a document, same as a post. Named
/// relations below (`"PostBody"`/`"PostBodyRu"`/`"WorkCaseStudy"`/
/// `"WorkCaseStudyRu"`) exist only because `Post`/`Work` each now have TWO
/// FKs pointing at this same model (an English document and, optionally,
/// an independent Russian one — see the migration plan's "язык — на
/// уровне документа, не поля блока") — Prisma requires an explicit name to
/// disambiguate once a model has more than one relation to the same
/// target.
model Document {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  blocks Block[]
  post   Post?   @relation("PostBody")
  postRu Post?   @relation("PostBodyRu")
  work   Work?   @relation("WorkCaseStudy")
  workRu Work?   @relation("WorkCaseStudyRu")
}

/// One row per paragraph/heading/image/code/quote/note/approachList, in
/// order. `type` is a plain String, not a Prisma/Postgres enum — enums are
/// a schema-level constraint, so adding a new block type would need a
/// migration every time; a String does not (see the block-storage
/// discussion in the migration plan for the full reasoning). `text` and
/// `data` are deliberately untyped Json here — the actual shape per `type`
/// is validated at the application layer (backend/src/content/blocks.ts,
/// Zod schemas), not the database layer.
model Block {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  order      Int
  type       String
  text       Json?
  data       Json?

  @@unique([documentId, order])
  @@index([documentId])
}

/// Journal entry. `bodyDocumentId` is nullable — an "upcoming" stub post
/// (announced, not yet written) has no body document at all.
/// `bodyDocumentIdRu`/`bodyRu` are the SAME kind of nullable relation, one
/// level further: independent of whether an English body exists, a
/// Russian translation of it may or may not exist yet. It's a wholly
/// separate `Document` (own blocks, own count/order), not a `ru` field
/// bolted onto every English block — see blocks.ts's top comment for why.
/// Written only through the translation endpoint (admin-posts.ts's
/// `translatePost`, staged in a `ContentDraft` and applied by
/// `publishPost` — see `content-draft.ts`), never through `createPost`.
model Post {
  id               String    @id @default(cuid())
  slug             String    @unique
  /// Set once, automatically, at creation (`createPost`) — never a form
  /// field. `dateLabel` (a free-text override for imprecise/upcoming
  /// dates) has been REMOVED — see backend/src/content/README.md's dated
  /// entry — the admin editor no longer exposes any date field at all.
  date             String
  title            Json
  category         Json
  readMins         Int
  excerpt          Json
  status           String
  relatedWorkSlug  String?
  bodyDocumentId   String?   @unique
  body             Document? @relation("PostBody", fields: [bodyDocumentId], references: [id])
  bodyDocumentIdRu String?   @unique
  bodyRu           Document? @relation("PostBodyRu", fields: [bodyDocumentIdRu], references: [id])
  /// Defaults to DRAFT — a brand new post never appears on the public site
  /// until an explicit `publishPost()` call (see admin-posts.ts), even
  /// though `status` above already defaults to `"published"`. Existing
  /// rows (all real content, predating this field) were backfilled to
  /// PUBLISHED by the migration that introduced this column — see its
  /// comment for why that backfill is mandatory, not optional.
  lifecycleState   LifecycleState @default(DRAFT)
  /// Set the first time this row transitions into PUBLISHED, then left
  /// alone — an UNPUBLISH does NOT clear it, so it keeps meaning "when was
  /// this last published," not "is this published right now" (that's what
  /// `lifecycleState` is for). No auto-unpublish safety net exists anymore
  /// (2026-08-09, draft/publish split) — a draft can no longer reach this
  /// row at all, so there's nothing left for a safety net to protect
  /// against; `publishPost` is the only path that ever moves this field.
  publishedAt      DateTime?
  /// "The CONTENT changed", as opposed to `updatedAt`'s "the ROW was
  /// touched" — the `lastmod` a search engine reads out of sitemap.xml and
  /// the `dateModified` in this post's JSON-LD. Written by `publishPost`
  /// ONLY when it actually applies a pending draft (a bare "Update" click
  /// with nothing pending is a genuine no-op, see `publishPost`'s own
  /// comment) — never by `unpublishPost`, which moves `@updatedAt` without a
  /// single character of the article changing. A systematically untruthful
  /// `lastmod` makes Google stop trusting it site-wide, which is why this
  /// couldn't just reuse `updatedAt`. Nullable with no backfill: rows
  /// predating this column report `publishedAt` instead of being handed a
  /// modification date that never happened.
  contentUpdatedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Set automatically by `createPost` — see `media/covers.ts`'s
  /// `generateCoverForPost`. Nullable only because Prisma requires it for
  /// an optional relation column, never actually null in practice once
  /// `createPost` has run; there is no admin flow that removes a cover
  /// without immediately generating a replacement (see `media/README.md`).
  ///
  /// Deliberately NOT `@unique` — a first design draft made it one-to-one
  /// and immediately broke `MediaAsset.contentHash`'s own dedup guarantee
  /// (found by a real, failing integration test, not by reasoning about
  /// it up front): two posts whose title/category/slug happen to produce
  /// byte-identical rasterized covers are supposed to share ONE
  /// `MediaAsset` row for free, and a unique constraint here would reject
  /// the second post's insert outright the moment that happened. A
  /// content-addressed asset is inherently many-to-one from the referring
  /// side, the same way two files with identical bytes share one blob in
  /// any content-addressed store.
  coverAssetId String?
  cover        MediaAsset? @relation(fields: [coverAssetId], references: [id])

  @@index([coverAssetId])
}

/// Project/work item. `startedLabel`/`shippedLabel`/`role` are case-study
/// metadata that stay scalar fields here (not part of the narrative
/// blocks) — see backend/src/content/README.md.
model Work {
  id                    String    @id @default(cuid())
  slug                  String    @unique
  title                 String
  year                  Int
  status                String
  summary               Json
  stack                 String[]
  coverImage            String?
  featured              Boolean   @default(false)
  relatedPostSlug       String?
  startedLabel          Json?
  shippedLabel          Json?
  role                  Json?
  /// The case-study detail page's large hero image — a separate field from
  /// `coverImage` (the small card/ledger thumbnail). Ported from the
  /// original `WorkCaseStudy.heroImage`; currently unset by every existing
  /// item (all show the placeholder pattern instead), kept for parity with
  /// the original shape rather than silently dropping a field nothing
  /// happens to use yet.
  heroImage             String?
  caseStudyDocumentId   String?   @unique
  caseStudy             Document? @relation("WorkCaseStudy", fields: [caseStudyDocumentId], references: [id])
  /// Independent Russian case-study Document — same reasoning as
  /// `Post.bodyDocumentIdRu` above (own blocks, written only through the
  /// translation endpoint). The label fields (`startedLabel`/
  /// `shippedLabel`/`role`) stay single `Json` `{en, ru}` values, not
  /// duplicated per language document — they're one string pair each,
  /// not a block list a translator restructures.
  caseStudyDocumentIdRu String?   @unique
  caseStudyRu           Document? @relation("WorkCaseStudyRu", fields: [caseStudyDocumentIdRu], references: [id])
  /// Same field, same reasoning as `Post.lifecycleState` above — Post and
  /// Work share one lifecycle graph (`content/lifecycle.ts`) even though
  /// their public `status` unions are unrelated to each other.
  lifecycleState        LifecycleState @default(DRAFT)
  /// Same field, same reasoning as `Post.publishedAt` above.
  publishedAt           DateTime?
  /// Same field, same reasoning as `Post.contentUpdatedAt` above — written
  /// by `publishWork`, and only when it actually applies a pending draft.
  contentUpdatedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// One row per slug a `Post`/`Work` USED to live at, pointing at where it
/// lives now. Written only by `publishPost`/`publishWork` when a pending
/// rename actually reaches the live slug (see content/slug-history.ts) —
/// staging a rename via `savePostDraft`/`saveWorkDraft` alone never
/// touches this table, since the live slug hasn't changed yet.
///
/// Exists because a rename otherwise throws away everything the old
/// address had earned: every external link to it breaks, and the search
/// engines that were just told (via IndexNow) that the URL changed find a
/// 404 there and simply drop it. A permanent redirect is what carries the
/// accumulated signals across; this table is the only place that knows
/// where to send them.
///
/// `kind` is a plain String, not a Prisma enum — same reasoning as
/// `Block.type` above: the set of content types is expected to grow, and
/// an enum would make each addition a migration. Unlike `LifecycleState`,
/// this isn't a closed transition graph owned by a state machine.
///
/// No foreign key to `Post`/`Work`: the reference is by slug (not by id)
/// and is polymorphic across two models, neither of which Prisma can
/// express as one relation. The consequence is handled explicitly —
/// `deletePost`/`deleteWork` clear an entity's rows, so a redirect can
/// never point at something that no longer exists.
model SlugHistory {
  id          String   @id @default(cuid())
  kind        String
  formerSlug  String
  /// Kept FLAT, never a chain: renaming a→b→c rewrites the a-row to point
  /// straight at c rather than leaving a→b→c for a crawler to walk.
  currentSlug String
  createdAt   DateTime @default(now())

  /// One destination per old address — a second row for the same
  /// `(kind, formerSlug)` would be an ambiguous redirect.
  @@unique([kind, formerSlug])
  /// Read by the chain-flattening update on every rename.
  @@index([kind, currentSlug])
}

/// The in-progress edit of a `Post`/`Work` that hasn't been published yet —
/// see backend/src/content/README.md's "черновик vs публикация" entry for
/// the bug this exists to fix (autosave used to overwrite the LIVE row
/// directly, so editing a published post could wipe what readers see
/// before the admin ever confirmed anything). `kind`/`entityId` (not a real
/// FK — same polymorphism as `SlugHistory` above) point at the `Post`/
/// `Work` row this is a pending edit of; `entityId` is the row's `id`, NOT
/// its `slug` — a rename can be part of an unpublished draft, so the slug
/// itself isn't a stable key while a draft exists. `data` is the whole
/// editable payload (`PostInput`/`WorkInput` plus an optional pending
/// `translation` section) as one JSON blob, validated at the application
/// layer (`content/content-draft.ts`) — same "untyped Json column, typed
/// boundary" split already used by `Block.text`/`Block.data`/
/// `SiteContent.data` above; a draft's shape already has exactly one
/// definition (the existing `postDraftInputSchema`/`workDraftInputSchema`),
/// so duplicating it as ~15 real columns here would just be a second
/// place for the two to silently drift apart.
///
/// One row per entity, not one per edit — `@@unique([kind, entityId])`
/// makes every autosave an upsert onto the SAME row, which is exactly
/// right: a draft is "what's pending right now," not a log of every
/// keystroke (that's what `ContentRevision` below is for, and it only
/// records PUBLISHED snapshots, not drafts-in-progress).
model ContentDraft {
  id        String   @id @default(cuid())
  kind      String
  entityId  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, entityId])
}

/// A snapshot of a `Post`/`Work`'s content taken immediately before an
/// already-PUBLISHED entity's live content is overwritten by a new
/// publish/update — i.e. "what readers were looking at right before this
/// change." Never written for a post's FIRST publish (there is nothing
/// live yet to preserve) — see `publishPost`/`publishWork`'s own comment.
/// `data` is the same draft-payload shape `ContentDraft.data` uses, so
/// "restore this version" is just "copy `data` back into a `ContentDraft`
/// row" (`restoreRevisionToDraft`), never a direct write to the live row —
/// a restore is reviewed and re-published like any other edit, not a
/// silent rollback of what's on the site right now.
///
/// Pruned to the most recent `MAX_REVISIONS` per entity by
/// `snapshotRevision` — this is version history for "I broke something,
/// let me go back," not a permanent audit log, so unbounded growth isn't
/// a trade-off worth making for a personal portfolio's admin panel.
model ContentRevision {
  id          String   @id @default(cuid())
  kind        String
  entityId    String
  data        Json
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@index([kind, entityId, createdAt])
}

/// A generic key→JSON settings bag for the handful of small, singleton
/// content sections that don't need their own table — `hero`, `contact`,
/// `principles`, `techStack`, `config`, `journalPage`, `workPage` (see the
/// migration plan's Phase 5). One row per section; `key` IS the row's
/// identity (no separate `id` column — there's no scenario where two rows
/// share a `key`, so a surrogate id would only add an unused column).
/// `data`'s shape is validated at the application layer per-key
/// (`backend/src/content/site-content.ts`'s Zod schemas), the same
/// "untyped Json column, typed application boundary" split `Block.text`/
/// `Block.data` already use above — a 7-arm union of very different
/// shapes (an array for `principles`, a nested object for `config`, ...)
/// has no single reasonable typed-column representation anyway, so this
/// isn't giving up type safety that a differently-shaped schema could
/// have kept.
model SiteContent {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

/// One row per generated file on disk — a journal post's cover today, any
/// future image (work covers, AI-generated art) tomorrow, without a new
/// table per image kind. See `backend/src/media/README.md` for the full
/// design; this comment only covers the columns.
///
/// `contentHash` is the sha256 of the FINAL rasterized bytes (the 1200x630
/// WebP, see `image-processing.ts`) — `@unique` gives byte-for-byte
/// deduplication for free: regenerating an identical cover (same slug, same
/// hue, same styleVersion, same variant — see `content-hash.ts`) reuses the
/// existing row and file instead of writing a second copy that differs only
/// in `id`.
///
/// `storageKey`, never an absolute URL — `media-store.ts`'s `MediaStore`
/// port is what turns a `storageKey` into a servable URL, so switching
/// storage backends later (disk → R2/S3, see media/README.md) is a
/// migration of the FILES, not of this column's meaning.
///
/// `generation` is untyped `Json` — same "typed at the application
/// boundary, not the database" split as `Block.text`/`Block.data`/
/// `SiteContent.data` above. Today it holds `{ generator: "procedural",
/// styleVersion, variant, seed, hue, svgSource }`; Phase 3's AI generator
/// adds `model`/`prompt` keys to the SAME column, no migration required —
/// that's the reason this is Json and not N separate nullable columns one
/// per generator's own fields.
model MediaAsset {
  id          String   @id @default(cuid())
  contentHash String   @unique
  storageKey  String
  mimeType    String
  width       Int
  height      Int
  byteSize    Int
  /// Inline low-quality placeholder (a tiny base64 data URI) — read
  /// straight off this row for `CoverImage`'s blur-up, no second disk read
  /// or extra network request just to show a placeholder while the real
  /// image loads.
  placeholder String
  /// What this asset is FOR — `"post-cover"` today, future kinds (a work
  /// cover, an inline body image) add a new string value here, never a new
  /// table. Plain `String`, not a Prisma enum, same reasoning as
  /// `Block.type`/`SlugHistory.kind` above: this set is expected to grow.
  kind        String
  generation  Json?
  createdAt   DateTime @default(now())

  /// A list, not `Post?` — see `Post.coverAssetId`'s own comment: this is a
  /// content-addressed row, and more than one `Post` sharing an identical
  /// rendered cover is an intended outcome of that, not an edge case.
  posts Post[]

  @@index([kind])
}

/// The persisted assignment of a hue (0-360°, OKLCH) to a post category —
/// see `media/README.md`'s "Назначение тона категории" entry for why this
/// has to be a stored assignment and cannot be a pure hash of the category
/// string. One row per category ever seen; never deleted by a rename (a
/// renamed category is a NEW key, and gets its own new row/ordinal/hue —
/// see that same README entry).
model CategoryHue {
  id         String   @id @default(cuid())
  /// Normalized `category.en` (see `content/localized-text.ts`) — the hue
  /// must not depend on the reader's locale, and a post's cover is the same
  /// asset in both languages.
  category   String   @unique
  hue        Float
  /// Assignment order — `hueForOrdinal(ordinal)` (cover-hue.ts) is a pure
  /// function of this number, van der Corput sequence base 2. Stored
  /// explicitly rather than derived from `count()` at read time: deleting a
  /// row (a category that's since been renamed away from) must never cause
  /// a LATER category to silently inherit an earlier ordinal's hue.
  ordinal    Int      @unique
  assignedAt DateTime @default(now())
}
